# WIM-Z Cloud Relay Configuration

# Application
DEBUG=false

# JWT Configuration (CHANGE THESE IN PRODUCTION)
JWT_SECRET_KEY=your-secure-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Device Authentication (CHANGE THIS IN PRODUCTION)
DEVICE_SECRET=your-secure-device-secret-change-this

# WebSocket Settings
WS_HEARTBEAT_INTERVAL=30
WS_CONNECTION_TIMEOUT=60
# Connection stability settings (Build 34) - helps with large file uploads
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=20
WS_MAX_MESSAGE_SIZE=20971520

#CLOUDFLARE TURN KEYS
CLOUDFLARE_TURN_KEY_ID=your_turn_key_id_here
CLOUDFLARE_TURN_API_TOKEN=your_turn_api_token_here

# Voice command WAV storage (empty = data/voice_commands next to the DB)
#VOICE_STORAGE_DIR=

# FCM push notifications: Firebase service-account JSON path
# (empty = data/firebase-service-account.json; missing file disables push)
#FCM_CREDENTIALS_PATH=

# Robot OTA release artifacts (empty = data/releases next to the DB).
# Must be a persistent path — manifest rows outlive /tmp across reboots.
#RELEASES_STORAGE_DIR=

# How many releases keep their artifact bytes on disk. Older releases keep
# their manifest row but lose the tarball. Artifacts run ~190MB.
#RELEASES_KEEP_ARTIFACTS=3

# ---- Dec 9 demo build (2026-11-06): event store, MCP connector, voice agent ----
# Shared secret for the same-box internal callers (wimz-mcp, wimz-agent). Required.
INTERNAL_API_TOKEN=
PUBLIC_BASE_URL=https://api.wimzai.com
RELAY_BASE_URL=http://127.0.0.1:8000
AGENT_BASE_URL=http://127.0.0.1:8002
DEFAULT_TIMEZONE=America/New_York
# Replayer (admin demo tooling)
DEMO_DOG_ID=demo_dog
DEMO_DEVICE_ID=demo_robot
# Robot media uploads (stills 24h, treat stills 7d, video 1h). Default <repo>/data/media.
# MEDIA_STORAGE_DIR=
# MCP server (run_mcp.py) — issuer defaults to PUBLIC_BASE_URL; local testing: http://127.0.0.1:8001
# MCP_PUBLIC_BASE_URL=
# MCP_ALLOWED_HOSTS=api.wimzai.com,api.wimzai.com:*,127.0.0.1:8001,localhost:8001
MCP_PORT=8001
# Voice agent (run_agent.py)
AGENT_PORT=8002
AGENT_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
AGENT_AUDIO_TTL_SECONDS=900
AGENT_BOOT_GREETING_DELAY_SECONDS=20
