# WIM-Z Cloud Relay Configuration

# Application
DEBUG=false

# JWT Configuration (CHANGE THESE IN PRODUCTION)
JWT_SECRET_KEY=your-secure-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Device Authentication (CHANGE THIS IN PRODUCTION)
DEVICE_SECRET=your-secure-device-secret-change-this

# WebSocket Settings
WS_HEARTBEAT_INTERVAL=30
WS_CONNECTION_TIMEOUT=60
# Connection stability settings (Build 34) - helps with large file uploads
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=20
WS_MAX_MESSAGE_SIZE=20971520

#CLOUDFLARE TURN KEYS
CLOUDFLARE_TURN_KEY_ID=your_turn_key_id_here
CLOUDFLARE_TURN_API_TOKEN=your_turn_api_token_here

# Voice command WAV storage (empty = data/voice_commands next to the DB)
#VOICE_STORAGE_DIR=

# FCM push notifications: Firebase service-account JSON path
# (empty = data/firebase-service-account.json; missing file disables push)
#FCM_CREDENTIALS_PATH=

# Robot OTA release artifacts (empty = data/releases next to the DB).
# Must be a persistent path — manifest rows outlive /tmp across reboots.
#RELEASES_STORAGE_DIR=

# How many releases keep their artifact bytes on disk. Older releases keep
# their manifest row but lose the tarball. Artifacts run ~190MB.
#RELEASES_KEEP_ARTIFACTS=3
